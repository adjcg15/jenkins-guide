	},
	"item": [
		{
			"name": "Get TO-DOs list",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response is an array\", function () {\r",
							"    pm.expect(pm.response.json()).to.be.an('array');\r",
							"});\r",
							"\r",
							"pm.test(\"Todos have required fields\", function () {\r",
							"    const todos = pm.response.json();\r",
							"    if (todos.length > 0) {\r",
							"        pm.expect(todos[0]).to.have.property('id');\r",
							"        pm.expect(todos[0]).to.have.property('title');\r",
							"        pm.expect(todos[0]).to.have.property('completed');\r",
							"    } else {\r",
							"        pm.expect(todos.length).to.eql(0);\r",
							"    }\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_path}}/todos",
					"host": [
						"{{base_path}}"
					],
					"path": [
						"todos"
					]
				}
			},
			"response": []
		},
		{
			"name": "Create TO-DO entry",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Todo created has an id\", function () {\r",
							"    const todo = pm.response.json();\r",
							"    pm.expect(todo).to.have.property('id');\r",
							"});\r",
							"\r",
							"pm.test(\"Todo created returns the same fields\", function () {\r",
							"    const req = pm.request.body.raw ? JSON.parse(pm.request.body.raw) : {};\r",
							"    const res = pm.response.json();\r",
							"    pm.expect(res.title).to.eql(req.title);\r",
							"    pm.expect(res.completed).to.eql(req.completed);\r",
							"});\r",
							"\r",
							"pm.collectionVariables.set(\"created_todo_id\", pm.response.json().id);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"title\": \"Comprar pan\",\r\n  \"completed\": false\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_path}}/todos",
					"host": [
						"{{base_path}}"
					],
					"path": [
						"todos"
					]
				}
			},
			"response": []
		},
		{
			"name": "Create TO-DO entry Copy",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 or 204\", function () {\r",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 204]);\r",
							"});\r",
							"\r",
							"pm.sendRequest({\r",
							"    url: pm.collectionVariables.get(\"base_path\") + \"/todos\",\r",
							"    method: \"GET\"\r",
							"}, function (err, res) {\r",
							"    pm.test(\"Todo was removed\", function () {\r",
							"        if (!err) {\r",
							"            const todos = res.json();\r",
							"            const id = pm.collectionVariables.get(\"created_todo_id\");\r",
							"            const exists = todos.some(t => t.id === Number(id));\r",
							"            pm.expect(exists).to.eql(false);\r",
							"        }\r",
							"    });\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"title\": \"Comprar pan\",\r\n  \"completed\": false\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_path}}/todos/{{created_todo_id}}",
					"host": [
						"{{base_path}}"
					],
					"path": [
						"todos",
						"{{created_todo_id}}"
					]
				}
			},
			"response": []
		}
	],
